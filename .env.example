# Copy to .env and fill in your Spotify Developer app credentials.
# (Used for Spotify track download / catalog metadata — not BPM/Key.)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Optional fallback when local WAV analysis misses BPM or Key
# https://getsongbpm.com/api
GETSONGBPM_API_KEY=
