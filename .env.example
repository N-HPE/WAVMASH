# ─── WaveMash Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your credentials.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

# ── Spotify API (마이그레이션 전용 — 구독 해지 전 플리 이전에만 필요) ─
# https://developer.spotify.com/dashboard
# 이전 완료 후 WAVMASH_AUTO_SYNC_ON_START=false 권장
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ── GetSongBPM API (BPM/Key 폴백, 선택) ──────────────────────────────
GETSONGBPM_API_KEY=

# ── WAV 라이브러리 경로 ─────────────────────────────────────────────
# WAVMASH_WAV_ROOT=

# ── Server / CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WAVMASH_HOST=127.0.0.1
# WAVMASH_PORT=8000
# WAVMASH_DEBUG=true
# Spotify 마이그레이션 자동 동기 (이전 끝나면 false)
# WAVMASH_AUTO_SYNC_ON_START=false

# ── Frontend (optional) ──────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Docker Compose port overrides (optional) ─────────────────────────
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# WAV_STORAGE_PATH=./data/wav
