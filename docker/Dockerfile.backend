# ============================================================================
# WaveMash FastAPI Backend Dockerfile
# Optimized for Render Web Service / Container Deployment
# ============================================================================
FROM python:3.11-slim AS base

# Install system audio and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency specifications first for layer caching
COPY server/requirements.txt /app/server/requirements.txt
COPY requirements.txt /app/requirements.txt

# Install backend Python requirements (with retries for PyPI network issues)
RUN pip install --no-cache-dir --retries 10 --default-timeout 100 -r /app/server/requirements.txt && \
    pip install --no-cache-dir --retries 10 --default-timeout 100 requests mutagen soundfile pydantic pydantic-settings yt-dlp ffmpeg-python librosa audioflux static_ffmpeg spotipy curl_cffi

# Copy codebase
COPY . /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WAVMASH_HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start Uvicorn dynamically binding to $PORT (assigned by Render / Docker)
CMD ["sh", "-c", "python -m uvicorn server.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
