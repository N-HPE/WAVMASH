# ─── WaveMash Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your credentials.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

# ── Spotify API (플레이리스트/트랙 다운로드에 필요) ──────────────────
# https://developer.spotify.com/dashboard 에서 앱 생성 후 Client ID/Secret 입력
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# spotipy 호환 (위와 동일 값 권장)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ── Supabase Cloud Database (PIXMASH와 동일 계정의 독립 wavmash 프로젝트) ─
# https://supabase.com 대시보드 -> wavmash 프로젝트 -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GetSongBPM API (BPM/Key 폴백, 선택) ──────────────────────────────
# https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# ── WAV 라이브러리 경로 (필수에 가까움 — 기기마다 다를 수 있음) ─────
# macOS 기본 예: /Users/YOU/Music/WaveMash
# Windows 예:   C:/Users/YOU/OneDrive/Desktop/WAV
# 비우면 OS별 기본 경로를 자동 선택합니다.
# WAVMASH_WAV_ROOT=

# ── Server / CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WAVMASH_HOST=127.0.0.1
# WAVMASH_PORT=8000
# WAVMASH_DEBUG=true
# 서버 시작 시 Spotify 동기화 플리 자동 실행 (맥/윈도우 누락 곡 보완)
# WAVMASH_AUTO_SYNC_ON_START=true

# ── Frontend (optional) ──────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Docker Compose port overrides (optional) ─────────────────────────
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# WAV_STORAGE_PATH=./data/wav
